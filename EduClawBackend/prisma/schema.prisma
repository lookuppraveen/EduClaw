generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  student
  faculty
  advisor
  admin
  auditor
}

enum EnrollmentRole {
  student
  faculty
  advisor
}

enum MaterialType {
  textbook
  lecture
  worksheet
}

enum ValidationStatus {
  approved
  modified
  blocked
}

enum AgentName {
  inference
  dialogue
  execution
  validation
  reflection
}

enum ReflectionKind {
  metacognitive
  goal_check
}

enum PolicyStatus {
  draft
  published
  archived
}

enum PolicyViolationAction {
  modify
  block
  flag
}

enum FlaggedTurnStatus {
  pending
  resolved
}

enum ReviewDecisionType {
  approve
  override
  escalate
}

enum IntegrationStatusValue {
  connected
  degraded
  disconnected
}

model User {
  id           String          @id
  name         String
  email        String          @unique
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  deletedAt    DateTime?
  roles        UserRoleAssignment[]
  sessions     Session[]
  enrollments  Enrollment[]
  learnerState LearnerState?
  consents     Consent?
  consentEdits ConsentHistory[] @relation("ConsentEditor")
  conversations Conversation[] @relation("ConversationLearner")
  createdPolicies ValidationPolicy[] @relation("PolicyCreator")
  updatedPolicies ValidationPolicy[] @relation("PolicyUpdater")
  reviewDecisions ReviewDecision[] @relation("ReviewDecisionReviewer")
  auditLogs AuditLog[] @relation("AuditLogActor")
}

model Role {
  name      UserRole @id
  createdAt DateTime @default(now())
  users     UserRoleAssignment[]
}

model UserRoleAssignment {
  userId    String
  roleName  UserRole
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleName], references: [name], onDelete: Restrict)

  @@id([userId, roleName])
  @@index([roleName])
}

model Session {
  id               String   @id
  userId           String
  refreshTokenHash String
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  revokedAt        DateTime?
  deletedAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Course {
  id          String       @id
  code        String
  title       String
  term        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  outcomes    Outcome[]
  materials   Material[]
  enrollments Enrollment[]
  conversations Conversation[]
  policies    ValidationPolicy[]

  @@index([code])
  @@unique([code, term])
}

model Outcome {
  id          String   @id
  courseId    String
  code        String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@unique([courseId, code])
}

model Material {
  id        String       @id
  courseId  String
  title     String
  type      MaterialType
  url       String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@unique([courseId, title, url])
}

model Enrollment {
  userId    String
  courseId  String
  role      EnrollmentRole
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([userId, courseId])
  @@index([courseId])
}

model LearnerState {
  learnerId    String            @id
  goals        LearnerGoal[]
  mastery      LearnerMastery[]
  reflections  ReflectionEntry[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  learner User @relation(fields: [learnerId], references: [id], onDelete: Cascade)
}

model LearnerGoal {
  id         String   @id
  learnerId  String
  text       String
  createdAt  DateTime

  learnerState LearnerState @relation(fields: [learnerId], references: [learnerId], onDelete: Cascade)

  @@index([learnerId])
}

model LearnerMastery {
  id         String   @id
  learnerId  String
  outcomeId  String
  score      Float
  evidence   String
  updatedAt  DateTime

  learnerState LearnerState @relation(fields: [learnerId], references: [learnerId], onDelete: Cascade)

  @@index([learnerId])
  @@index([outcomeId])
  @@unique([learnerId, outcomeId])
}

model ReflectionEntry {
  id         String         @id
  learnerId  String
  prompt     String
  response   String
  kind       ReflectionKind @default(metacognitive)
  createdAt  DateTime

  learnerState LearnerState @relation(fields: [learnerId], references: [learnerId], onDelete: Cascade)

  @@index([learnerId])
}

model Consent {
  learnerId             String   @id
  courseContext         Boolean  @default(true)
  priorConversations    Boolean  @default(true)
  advisorVisibility     Boolean  @default(false)
  thirdPartyTools       Boolean  @default(false)
  updatedAt             DateTime @updatedAt

  learner User @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  history ConsentHistory[]
}

model ConsentHistory {
  id                   String   @id
  learnerId            String
  actorUserId          String
  reason               String?
  courseContext        Boolean
  priorConversations   Boolean
  advisorVisibility    Boolean
  thirdPartyTools      Boolean
  createdAt            DateTime @default(now())

  consent Consent @relation(fields: [learnerId], references: [learnerId], onDelete: Cascade)
  actor   User    @relation("ConsentEditor", fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([learnerId])
  @@index([actorUserId])
  @@index([learnerId, createdAt])
}

model Conversation {
  id           String            @id
  learnerId    String
  courseId     String
  assignmentId String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  deletedAt    DateTime?
  turns        ConversationTurn[]

  learner User   @relation("ConversationLearner", fields: [learnerId], references: [id], onDelete: Cascade)
  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([learnerId])
  @@index([courseId])
  @@index([learnerId, courseId, createdAt])
}

model ConversationTurn {
  id                  String          @id
  conversationId      String
  learnerId           String
  courseId            String
  assignmentId        String?
  studentInput        String
  selectedChip        String?
  inferenceIntent     String
  inferenceConfusion  String
  inferenceGap        String
  inferenceUrgency    String
  inferenceConfidence Float
  inferenceRationale  String
  inferenceNextAgent  AgentName
  dialogueQuestion    String
  dialogueChips       String[]
  executionScaffold   String
  executionExamples   String[]
  executionCitations  Json
  executionAction     String
  validationStatus    ValidationStatus
  validationReason    String
  validationMessage   String
  validationClause    String
  reflectionPrompt    String
  reflectionKind      ReflectionKind
  reflectionOptional  Boolean
  createdAt           DateTime        @default(now())
  traces              AgentTrace[]
  flaggedTurn         FlaggedTurn?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([learnerId])
  @@index([courseId])
  @@index([learnerId, courseId, createdAt])
}

model AgentTrace {
  id              String    @id
  turnId          String
  agent           AgentName
  startedAt       DateTime
  durationMs      Int
  confidence      Float
  outputSummary   String
  internalDetails String
  createdAt       DateTime  @default(now())

  turn ConversationTurn @relation(fields: [turnId], references: [id], onDelete: Cascade)

  @@index([turnId])
  @@index([agent])
  @@unique([turnId, agent])
}

model ValidationPolicy {
  id           String          @id
  courseId     String
  assignmentId String?
  title        String
  status       PolicyStatus    @default(draft)
  publishedAt  DateTime?
  createdById  String
  updatedById  String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  deletedAt    DateTime?
  clauses      PolicyClause[]
  reviewDecisions ReviewDecision[]

  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdBy User   @relation("PolicyCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User?  @relation("PolicyUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([courseId])
  @@index([assignmentId])
  @@index([status])
  @@index([courseId, assignmentId, status])
}

model PolicyClause {
  id          String                @id
  policyId    String
  rule        String
  when        String
  onViolation PolicyViolationAction
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  flaggedTurns FlaggedTurn[]
  reviewDecisions ReviewDecision[]

  policy ValidationPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
  @@unique([policyId, rule])
}

model FlaggedTurn {
  id          String            @id
  turnId      String            @unique
  policyId    String
  clauseId    String
  courseId    String
  learnerId   String
  status      FlaggedTurnStatus @default(pending)
  reason      String
  createdAt   DateTime          @default(now())
  resolvedAt  DateTime?
  decisions   ReviewDecision[]

  turn   ConversationTurn @relation(fields: [turnId], references: [id], onDelete: Cascade)
  clause PolicyClause     @relation(fields: [clauseId], references: [id], onDelete: Restrict)

  @@index([policyId])
  @@index([courseId])
  @@index([learnerId])
  @@index([status])
}

model ReviewDecision {
  id          String             @id
  flagId      String
  reviewerId  String
  decision    ReviewDecisionType
  note        String
  policyId    String
  clauseId    String
  courseId    String
  createdAt   DateTime           @default(now())

  flaggedTurn FlaggedTurn      @relation(fields: [flagId], references: [id], onDelete: Cascade)
  reviewer    User             @relation("ReviewDecisionReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  policy      ValidationPolicy @relation(fields: [policyId], references: [id], onDelete: Restrict)
  clause      PolicyClause     @relation(fields: [clauseId], references: [id], onDelete: Restrict)

  @@index([flagId])
  @@index([reviewerId])
  @@index([policyId])
  @@index([clauseId])
  @@index([courseId])
  @@index([decision])
}

model IntegrationStatus {
  name          String                 @id
  displayName   String
  status        IntegrationStatusValue
  details       String
  lastCheckedAt DateTime
  updatedAt     DateTime               @updatedAt
}

model AuditLog {
  id          String   @id
  actorUserId String?
  action      String
  targetType  String
  targetId    String?
  metadata    Json
  createdAt   DateTime @default(now())

  actor User? @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([action])
  @@index([targetType])
  @@index([createdAt])
}

model IdempotencyRecord {
  id             String   @id
  principal      String
  method         String
  path           String
  idempotencyKey String
  bodyHash       String
  statusCode     Int
  responseBody   Json
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@unique([principal, method, path, idempotencyKey])
  @@index([expiresAt])
}

model RateLimitBucket {
  key       String   @id
  count     Int
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model HttpMetric {
  id          String   @id
  method      String
  route       String
  statusClass String
  count       Int
  sumSeconds  Float
  bucketCounts Int[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([method, route, statusClass])
}
