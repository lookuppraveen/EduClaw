# PostgreSQL credentials differ from the default educlaw/educlaw test role.
# TEST_DATABASE_URL=postgresql://educlaw:educlaw@localhost:5432/educlaw_test?schema=public
# Set TEST_DATABASE_ADMIN_URL, then run `npm run test:db:setup`, to create the
# expected test role/database through an existing PostgreSQL admin database.
# TEST_DATABASE_ADMIN_URL=postgresql://postgres:password@localhost:5432/postgres?schema=public
DATABASE_URL=postgresql://educlaw:educlaw@localhost:5432/educlaw_test?schema=public
